[Unit]
Description=Northstar Guard lightweight server malware monitor
After=local-fs.target clamd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/northstar-guard --daemon
Restart=on-failure
RestartSec=10
User=root
Group=root
Environment=NORTHSTAR_DATA=/var/lib/northstar-guard
Environment=NORTHSTAR_WATCH_ROOTS=/home/ray/Downloads:/home/ray/.config/autostart:/tmp:/var/tmp:/etc/systemd/system:/etc/cron.d:/etc/cron.daily:/usr/local/bin:/usr/local/sbin
Nice=15
CPUQuota=5%
MemoryMax=128M
TasksMax=96
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/northstar-guard
UMask=022

[Install]
WantedBy=multi-user.target
