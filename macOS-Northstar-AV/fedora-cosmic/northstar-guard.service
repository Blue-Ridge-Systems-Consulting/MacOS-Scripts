[Unit]
Description=Northstar Guard live malware monitor
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/northstar-guard --daemon
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=15%
MemoryMax=256M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
